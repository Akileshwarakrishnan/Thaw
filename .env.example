# Environment Configuration
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id_here
PAYPAL_SELLER_EMAIL=merchant-test@example.com

# AI Provider (Gemini / Anthropic / OpenAI - Intelligent fallback included)
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash

# Database Connection (SQLite local or Postgres for Render)
DATABASE_URL="file:./prisma/dev.db"

# Public App Base URL (Render URL, or ngrok for local webhook testing)
APP_BASE_URL="http://localhost:3000"

# Demo Mode (loads seeded stores automatically, skips auth for judges)
DEMO_MODE=true

# Session Security
SESSION_SECRET="thaw_secure_session_secret_key_change_in_production"
